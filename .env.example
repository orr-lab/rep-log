# Copy this file to .env.local and fill in real values. See README.md for where each one comes
# from and, for SITE_PASSWORD/VISITOR_PASSWORD, whether it needs to stay set after first use.

# Postgres connection string (Neon via Vercel Marketplace, or any Postgres). Pulled automatically
# by `vercel env pull .env.local` once your project is linked and a database is provisioned.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Seeds the admin account the first time scripts/seed-admin.js runs, and permanently keys the
# session-cookie signature (see src/lib/auth.ts) -- must stay set forever, never leave it empty.
SITE_PASSWORD=""

# Optional. Seeds the admin's own visitor (read-only) password at the same one-time seeding step.
# Only ever read by scripts/seed-admin.js -- safe to remove after the admin account exists.
VISITOR_PASSWORD=""

# Optional. Sets the seeded admin's username (defaults to "admin"). Only read by seed-admin.js.
ADMIN_USERNAME=""

# Created automatically by `vercel blob create-store`, or from the Blob store's settings in the
# Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# Optional. Powers the "Get AI feedback" button. Get a free key at
# https://aistudio.google.com/apikey. Leave unset to disable the feature.
GEMINI_API_KEY=""

# Optional. Netscape cookie-file contents (newlines and all) for a real, logged-in YouTube
# session -- lets yt-dlp download YouTube video for AI feedback from cloud IPs that YouTube
# would otherwise block. Treat this like a credential. Leave unset to skip.
YOUTUBE_COOKIES=""
